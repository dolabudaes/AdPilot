# Copy to repo-root `.env.local` (single env file for Web + API + scripts).
#   cp .env.example .env.local

# LLM (Next.js server + FastAPI)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Data paths (relative to repo root unless absolute)
SQLITE_PATH=data/adpilot.db
ADPILOT_DATA_DIR=data
ADPILOT_ROOT=

# API
API_URL=http://127.0.0.1:8000

# Evaluation / investigation tuning
ADPILOT_EVAL_LIVE_LLM=0
ADPILOT_EVAL_INVESTIGATION_ARM=rule
ADPILOT_INVESTIGATION_TIMEOUT_MS=90000
ADPILOT_MAX_LLM_CALLS=8

# UI / smoke tests (optional)
ADPILOT_BASE_URL=http://127.0.0.1:3011
# NEXT_PUBLIC_* — add here if client bundles need public env
