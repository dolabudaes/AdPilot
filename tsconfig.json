{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/*"]
    },
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "apps/web/better-sqlite3.d.ts"]
}
