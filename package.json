{
  "name": "adpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w adpilot-web",
    "dev:api": "bash scripts/with-venv.sh uvicorn app.main:app --reload --port 8000 --app-dir apps/api",
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "data:prepare": "bash scripts/with-venv.sh python scripts/preprocess_criteo.py",
    "build": "npm run build -w adpilot-web",
    "start": "npm run start -w adpilot-web",
    "stop": "lsof -ti:3011 | xargs kill -9 2>/dev/null || true",
    "restart": "npm run stop && npm run start",
    "rebuild:serve": "npm run stop && npm run build && npm run start",
    "lint": "npm run lint -w adpilot-web",
    "typecheck": "npm run typecheck -w adpilot-web",
    "test:tools": "tsx tests/test-tools.ts",
    "test:agent": "tsx tests/test-agent-paths.ts",
    "test:investigate": "node tests/test-investigate.mjs",
    "test:versions": "tsx tests/test-strategy-versions.ts",
    "test:decision-workflow": "tsx tests/test-decision-workflow.ts",
    "test:conversation": "tsx tests/test-conversation-window.ts",
    "test:conversation-opening": "tsx tests/test-conversation-opening.ts",
    "test:story": "node tests/test-launch-story.mjs",
    "test:product-ui": "node tests/test-product-ui.mjs",
    "test:workspace-nav": "tsx tests/test-workspace-nav.ts",
    "test:workspace-ux": "tsx tests/test-workspace-ux.ts",
    "test:proposal-ux": "tsx tests/test-proposal-ux.ts",
    "test:natural-conversation": "tsx tests/test-natural-conversation.ts",
    "test:history-recovery": "tsx tests/test-history-recovery.ts",
    "test:saved-history": "tsx tests/test-saved-history.ts",
    "demo:cleanup-history": "tsx scripts/cleanup-demo-history.ts",
    "demo:seed-story": "tsx scripts/seed-campaign-r-story.ts",
    "demo:seed-r-story": "tsx scripts/seed-campaign-r-story.ts",
    "test:investigation-scope": "tsx tests/test-investigation-scope.ts",
    "test:eval": "tsx tests/test-eval.ts",
    "eval": "tsx scripts/run-evaluation.ts",
    "eval:live-llm": "ADPILOT_EVAL_LIVE_LLM=1 ADPILOT_EVAL_INVESTIGATION_ARM=llm tsx scripts/run-evaluation.ts",
    "test:smoke-llm": "tsx tests/smoke-investigation-llm.ts",
    "test:data-semantics": "PYTHONPATH=scripts bash scripts/with-venv.sh python tests/test_data_semantics.py",
    "test:api-compat": "node tests/test-api-compat.mjs",
    "test:data-contract": "tsx tests/test-data-contract.ts",
    "test:demo-investigations": "tsx tests/test-demo-investigations.ts",
    "demo:build-investigations": "tsx scripts/build-demo-investigations.ts",
    "test:demo-decision-flow": "tsx tests/test-demo-decision-flow.ts",
    "test:detail-polish": "tsx tests/test-detail-polish.ts",
    "test:decision-selection": "tsx tests/test-decision-selection.ts",
    "test:data-consistency": "tsx tests/test-data-consistency.ts",
    "test:investigation-packet": "tsx tests/test-investigation-packet.ts",
    "test:decisions-layout": "node tests/test-decisions-layout.mjs",
    "test:final-qa": "tsx tests/test-final-qa.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
